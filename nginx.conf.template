server {
    listen 80;
    server_name polysignals.ru www.polysignals.ru afisha.polysignals.ru plan.polysignals.ru _;
    root /var/www/city-widget;
    index index.html;

    location /api/kudago/ {
        proxy_pass https://kudago.com/public-api/;
        proxy_ssl_server_name on;
        proxy_set_header Host kudago.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 20s;
    }

    location /api/timepad/ {
        proxy_pass https://api.timepad.ru/;
        proxy_ssl_server_name on;
        proxy_set_header Host api.timepad.ru;
        proxy_set_header Authorization "Bearer ${TIMEPAD_API_TOKEN}";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 20s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
